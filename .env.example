# Copy to .env and fill in. Never commit .env.

# production | development | testing
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
# Leave empty to detect automatically, or set e.g. /omps when the app is served under a sub path
APP_BASE_PATH=
# auto | on | off  (auto: pretty URLs when mod_rewrite is available)
APP_REWRITE=auto
# Encryption key for ID numbers and family contact details. Create with: php omps key:generate
# Keep a copy with your backups: without it encrypted data cannot be read.
APP_KEY=
# Where uploaded files are kept (outside the web root). Default: storage/files
FILES_PATH=
UPLOAD_MAX_MB=50
# Where backups are written (database + files). Default: storage/backups. Better on another disk or a NAS.
BACKUP_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omps
# Day-to-day account: SELECT, INSERT, UPDATE, DELETE only
DB_USERNAME=omps_app
DB_PASSWORD=
# Migration account: may create and alter tables; used only by "php omps migrate"
DB_MIGRATE_USERNAME=omps_migrate
DB_MIGRATE_PASSWORD=

# Set to true when the site is served over HTTPS behind a proxy
SESSION_SECURE=false
